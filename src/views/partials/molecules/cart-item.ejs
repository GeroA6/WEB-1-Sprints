<div class="carrito-producto">
    <div class="producto-left">
        <img src="<%= imgSrc %>" alt="">
        <p><%= title %></p>
    </div>
    <div class="producto-right">
        <!-- Botón Quitar -->
        <form action="/cart/remove/<%= id %>" method="POST" style="display: inline;">
            <button class="boton-quitar" type="submit" >Quitar</button>
        </form>
        
        <div class="boton" style="display: flex; align-items: center;">
            <!-- Botón ➖ -->
            <form action="/cart/update/<%= id %>?action=decrease" method="POST" style="margin: 0;">
                <button type="submit">-</button>
            </form>
            
            <!-- Cantidad actual -->
            <button disabled style="color: black;"><%= locals.quantity || 1 %></button>
            
            <!-- Botón ➕ -->
            <form action="/cart/update/<%= id %>?action=increase" method="POST" style="margin: 0;">
                <button type="submit">+</button>
            </form>
        </div>
        <h1><%= price %></h1>
    </div>
</div>