<a href="<%= locals.link || '#' %>" class="card-producto-link" aria-label="<%= title %>">
    <article class="producto-card">
        <div class="producto-imagen-box">
            <img src="<%= imgSrc %>" alt="<%= title %>" loading="lazy">
        </div>
        <div class="producto-info-box">
            <h3 class="producto-titulo-ml"><%- title %></h3>
            <div class="producto-precio-box">
                <span class="producto-precio">$<%= puntos %></span>
                <span class="producto-puntos-label">PUNTOS</span>
            </div>
            <% if (locals.stock > 0) { %>
                <span class="badge-envio-gratis">Envío gratis</span>
            <% } else { %>
                <span class="badge-sin-stock-ml">Sin stock</span>
            <% } %>
        </div>
    </article>
</a>