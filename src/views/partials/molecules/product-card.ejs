<a href="<%= locals.link || '#' %>">
    <div class="producto">
        <div class="imagen">
            <img src="<%= imgSrc %>" alt="">
        </div>
        <div class="box-detalles">
            <h3 class="producto-titulo"><%- title %></h3>
            <hr>
            <div class="producto-detalles">
                <h3><%= puntos %></h3>
                <p>PUNTOS</p>
                 <% if (locals.stock === 0) { %>
                <div class="badge-sin-stock" style="background-color: #ff4d4f; color: white; text-align: center; padding: 4px; border-radius: 4px; margin-top: 10px; font-weight: bold;">Sin stock</div>
            <% } %>
            </div>
           
        </div>
    </div>
</a>