<!--Esto es una plantilla-->

<div class="form-grupo">
    <input 
        type="<%= tipo %>"
        id="<%= id %>"
        name="<%= id %>"
        class="form-input"
        placeholder=""
        <%# Si el controlador nos envió datos viejos (oldData), los usamos para rellenar el campo. %>
        value="<%= locals.oldData && oldData[id] ? oldData[id] : '' %>"
        required
    >
    <label for="<%= id %>" class="form-label"><%= etiqueta %></label>
    <span class="form-line"></span>
</div>