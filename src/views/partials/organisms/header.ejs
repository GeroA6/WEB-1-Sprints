<header>
    <div class="header-nav">
        <a href="/" class="header-a">
            <img class="img1" src="/img/Negratone2.png">
            
            <% if (!isAuthPage) { %>
                <img class="img2" src="/img/logo-negratone2.png">
            <% } %>
        </a>

        <% if (!isAuthPage) { %>
            <form action="/search" method="GET" class="header-search">
                <input type="text" name="query" placeholder="Buscar productos..." required>
                <button type="submit"><i class="fa-solid fa-magnifying-glass"></i></button>
            </form>

            <div class="box-icons">
                <div class="icon">
                    <a href="/cart" class="fa-solid fa-cart-shopping"></a>
                    <% if (locals.cartCount && locals.cartCount > 0) { %>
                        <span class="cart-badge"><%= locals.cartCount %></span>
                    <% } %>
                </div>
                <div class="icon">    
                    <a href="/profile" class="fa-solid fa-user">
                        <p>Perfil</p>
                    </a>
                </div>
            </div>
        <% } %>
    </div>
</header>