<div class="box-productos">
    <%# Si la variable products existe y tiene al menos 1 producto, los dibujamos %>
    <% if (locals.products && products.length > 0) { %>
        <% products.forEach(product => { %>
            <%- include('../molecules/product-card', { 
                link: '/products/' + product.id, 
                imgSrc: formatImgUrl(product.image), 
                title: product.name, 
                puntos: product.price,
                stock: product.stock
            }) %>
        <% }) %>
    <% } else { %>
        <p style="text-align: center; width: 100%; color: var(--text-muted); padding: 2rem 0;">No hay productos para mostrar en esta sección.</p>
    <% } %>
</div>