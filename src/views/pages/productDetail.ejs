<%- include('../partials/global/head') %>

    <body>
        <%- include('../partials/organisms/header') %>
            <main>
                <%- include('../partials/atoms/back-link', { textoVolver: 'Volver' , categoria: product.category }) %>
                    <div class="main">
                        <div class="container">
                            <%# Como el objeto de producto solo tiene una imagen, la usaremos para toda la galería. %>
                            <%- include('../partials/molecules/product-gallery', { 
                                thumb1: formatImgUrl(product.image), 
                                thumb2: formatImgUrl(product.image), 
                                thumb3: formatImgUrl(product.image), 
                                mainImage: formatImgUrl(product.image) 
                            }) %>

                                        <%- include('../partials/molecules/product-description', { id: product.id,
                                            title: product.name, puntos: product.price, descripcion:
                                            product.description, stock: product.stock }) %>
                        </div>
                    </div>
                    <% if (locals.relacionados && relacionados.length > 0) { %>
                        <section class="section-productos" style="margin-top: 2rem;">
                            <div class="contenedor-productos">
                                <h2>Productos Relacionados</h2>
                                <%- include('../partials/organisms/list-products', { products: relacionados }) %>
                            </div>
                        </section>
                    <% } %>
                        <%- include('../partials/organisms/nav-bar')%>
            </main>
            <%- include('../partials/organisms/footer') %>
    </body>