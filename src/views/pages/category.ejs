<%- include('../partials/global/head') %>
<body>
    <%- include('../partials/organisms/header') %>
    <main>
        <%- include('../partials/organisms/nav-bar') %>
        
        <%- include('../partials/atoms/back-link', {
            textoVolver: 'Volver al inicio',
            categoria: '/'
        }) %>

        <section class="section-productos">
            <div class="contenedor-productos">
                <h1 style="text-transform: capitalize; margin-bottom: 1.5rem; font-size: 1.5rem;">
                    Categoría: <%= categoriaNombre %>
                </h1>
                
                <% if (productos.length === 0) { %>
                    <div class="empty-state" style="text-align: center; padding: 4rem 2rem; background-color: var(--surface); border-radius: var(--radius-md);">
                        <p style="font-size: 1.2rem; color: var(--text-muted);">No encontramos productos para esta categoría por el momento. ¡Pronto subiremos novedades!</p>
                    </div>
                <% } else { %>
                    <%- include('../partials/organisms/list-products', { products: productos }) %>
                <% } %>
            </div>
        </section>
    </main>
    <%- include('../partials/organisms/footer') %>
</body>