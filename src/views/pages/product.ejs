<%- include('../partials/atoms/back-link', { textoVolver: 'Volver al Home' , categoria: productos.category
    || 'Productos' }) %>

    <div class="main">
        <div class="container">
            <%- include('../partials/molecules/product-gallery', { 
                thumb1: formatImgUrl(producto.image), 
                thumb2: formatImgUrl(producto.image), 
                thumb3: formatImgUrl(producto.image), 
                mainImage: formatImgUrl(producto.image) 
            }) %>

                <%- include('../partials/molecules/product-description', { id: producto.id, title: producto.name,
                    puntos: producto.price, descripcion: producto.description, stock: producto.stock }) %>
        </div>
    </div>

    <section class="section-relacionados" style="margin-top: 2rem;">
        <div class="contenedor-productos">
            <h2> Productos Relacionados</h2>

            <% if (relacionados.length===0) { %>

                <div class="empty-state" style="text-align: center; padding: 2rem; color: #666;">
                    <p>Por el momento no hay alternativas similares en esta categoría. ¡Sigue explorando nuestro
                        catálogo!</p>
                </div>

                <% } else { %>
                    <div class="box-productos">
                        <% relacionados.forEach(relacionado=> { %>

                            <%- include('../partials/molecules/product-card', { link: '/products/' + relacionado.id,
                                imgSrc: formatImgUrl(relacionado.image), 
                                title: relacionado.name, puntos: relacionado.price,
                                stock: relacionado.stock }) %>
                                <% }) %>
                    </div>
                    <% } %>
    </section>
    <%- include('../partials/organisms/list-products')%>
        <%- include('../partials/organisms/nav-bar')%>